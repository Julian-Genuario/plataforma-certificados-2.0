[Unit]
Description=Alta de nuevos suscriptos de brisaplus en los eventos (solo agrega)
After=network.target

[Service]
Type=oneshot
User=certif
Group=www-data
WorkingDirectory=/opt/certificados
EnvironmentFile=/etc/certificados.env
ExecStart=/opt/certificados/.venv/bin/python /opt/certificados/manage.py sync_brisa_inscriptos
